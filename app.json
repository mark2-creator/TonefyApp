{
  "expo": {
    "name": "Tonefy AI",
    "slug": "tonefyapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "updates": {
      "url": "https://u.expo.dev/018af7f9-832e-4a3b-88e7-141fc911fb1e"
    },
    "runtimeVersion": "1.0.0",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.ahumuza21213.TonefyApp",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "018af7f9-832e-4a3b-88e7-141fc911fb1e"
      }
    },
    "plugins": [
      "expo-video",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Tonefy AI to access your photos to create videos.",
          "cameraPermission": "Allow Tonefy AI to access your camera to record media for videos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-only.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#fefeff"
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "fitlifesolutions",
          "project": "react-native"
        }
      ]
    ],
    "scheme": "tonefyai",
    "owner": "charlieanderson21213",
    "ios": {}
  }
}
