{
  "expo": {
    "name": "Tonefy AI",
    "slug": "tonefyapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "updates": {
      "url": "https://u.expo.dev/ba6875dd-5a8f-438f-91f4-58f4ac5b17c1",
      "checkAutomatically": "ON_LOAD",
      "channel": "preview"
    },
    "runtimeVersion": "1.1.0",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.ahumuza21213.TonefyApp",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-video",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Tonefy AI to access your photos to create videos.",
          "cameraPermission": "Allow Tonefy AI to access your camera to record media for videos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Tonefy AI to access your camera to record videos.",
          "microphonePermission": "Allow Tonefy AI to access your microphone to record audio."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-only.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#fefeff"
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "fitlifesolutions",
          "project": "react-native"
        }
      ]
    ],
    "scheme": "tonefyai",
    "owner": "mumberemike4",
    "ios": {},
    "extra": {
      "eas": {
        "projectId": "ba6875dd-5a8f-438f-91f4-58f4ac5b17c1"
      }
    }
  }
}
